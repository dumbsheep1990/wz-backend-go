# 万知网站后端 Admin Service 环境配置示例
# 复制此文件为 .env 并根据实际环境修改

# 数据库配置
DB_DSN=root:password@tcp(localhost:3306)/wz_admin?charset=utf8mb4&parseTime=True&loc=Local

# Redis配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT配置
JWT_SECRET_KEY=万知网站后台加密密钥请修改此默认值
JWT_EXPIRATION_MINUTES=1440  # 24小时

# Casbin配置 (留空使用内置默认模型)
CASBIN_MODEL_PATH=
CASBIN_POLICY_PATH=

# 服务配置
PORT=8080

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/admin-service.log

# 万知网站信息
WZ_COMPANY_NAME=南京万知园信息工程有限公司
WZ_COPYRIGHT_YEAR=2023
WZ_ICP=苏ICP备19049108号
WZ_POLICE=苏公网安备 32010402000846号
WZ_CONTACT_PHONE=0515-88200000
WZ_CONTACT_EMAIL=2895915959@qq.com
WZ_CONTACT_ADDRESS=江苏省盐城市通港路11号综合楼一楼1号
