// Address 地址值对象
type Address struct {
	Country  string
	Province string
	City     string
	District string
	Street   string
	PostCode string
}

// NewAddress 创建地址值对象
func NewAddress(country, province, city, district, street, postCode string) Address {
	return Address{
		Country:  country,
		Province: province,
		City:     city,
		District: district,
		Street:   street,
		PostCode: postCode,
	}
}

// Equals 比较两个地址值对象是否相等
func (a Address) Equals(other Address) bool {
	return a.Country == other.Country &&
		a.Province == other.Province &&
		a.City == other.City &&
		a.District == other.District &&
		a.Street == other.Street &&
		a.PostCode == other.PostCode
}

// FullAddress 获取完整地址字符串
func (a Address) FullAddress() string {
	parts := []string{}
	if a.Country != "" {
		parts = append(parts, a.Country)
	}
	if a.Province != "" {
		parts = append(parts, a.Province)
	}
	if a.City != "" {
		parts = append(parts, a.City)
	}
	if a.District != "" {
		parts = append(parts, a.District)
	}
	if a.Street != "" {
		parts = append(parts, a.Street)
	}
	
	return strings.Join(parts, " ")
}

